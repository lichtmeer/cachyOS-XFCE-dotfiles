configuration {
    font:                           "Noto Sans 12";
    show-icons:                     true;
    icon-theme:                     "YAMIS";
    kb-cancel:                      "Escape,Super+space";
}

* {
    bg0:                           #1C1B1FFF;
    bg1:                           #2A2930FF;
    bg3:                           #A4C3FFFF;
    fg0:                           #E6E1E5FF;
    fg3:                           #9A9BA2FF;

    background-color:              transparent;
    text-color:                    @fg0;
    margin:                        0px;
    padding:                       0px;
    spacing:                       0px;
}

window {
    location:                      center;
    width:                         380px;
    border-radius:                 24px;
    background-color:              @bg0;
}

mainbox {
    padding:                       14px;
    children:                      [ "message", "listview" ];
}

message {
    background-color:              transparent;
    padding:                       4px 8px 8px;
}

textbox {
    text-color:                    @fg3;
    horizontal-align:              0.5;
    padding:                       4px;
}

listview {
    background-color:             transparent;
    columns:                       1;
    lines:                         5;
    fixed-height:                  false;
    spacing:                       8px;
}

element {
    padding:                       16px 12px;
    border-radius:                 18px;
    spacing:                       12px;
}

element normal.normal,
element alternate.normal {
    background-color:              @bg1;
    text-color:                    @fg0;
}

element selected.normal {
    background-color:              @bg1;
    text-color:                    @fg0;
    border:                         2px;
    border-color:                  @bg3;
}

element-icon {
    size:                          1.4em;
    padding:                       0 4px 0 12px;
    background-color:              transparent;
    vertical-align:                0.5;
}

element-text {
    text-color:                    inherit;
    horizontal-align:              0.5;
    vertical-align:                0.5;
    padding:                       0 12px 0 0;
}
