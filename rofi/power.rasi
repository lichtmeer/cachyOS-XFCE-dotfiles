configuration {
    font:                           "Noto Sans 11";
    show-icons:                     true;
    icon-theme:                     "YAMIS";
    kb-cancel:                      "Escape,Super+space";
}

* {
    bg0:                           #1C1B1FFF;
    bg1:                           #2A2930FF;
    bg3:                           #A4C3FFFF;
    fg0:                           #E6E1E5FF;
    fg2:                           #E6E1E5FF;
    fg3:                           #9A9BA2FF;

    background-color:              transparent;
    text-color:                    @fg0;
    margin:                        0px;
    padding:                       0px;
    spacing:                       0px;
}

window {
    location:                      center;
    width:                         420px;
    border-radius:                 24px;
    background-color:              @bg0;
}

mainbox {
    padding:                       4px 12px 12px;
    children:                      [ "message", "inputbar", "listview" ];
    spacing:                       4px;
}

message {
    background-color:              transparent;
    padding:                       16px 0 8px;
}

textbox {
    font:                          "Symbols Nerd Font 28";
	text:                          "⏻";
    text-color:                    @fg2;
    horizontal-align:              0.5;
    padding:                       8px;
}

inputbar {
    background-color:             @bg1;
    border:                        2px;
    border-color:                  @bg3;
    border-radius:                 16px;
    padding:                       10px 16px;
    spacing:                       8px;
    children:                      [ "prompt", "entry" ];
    margin:                        0 4px;
}

prompt {
    text-color:                    @fg0;
}

entry {
    text-color:                    @fg0;
    placeholder:                   "";
}

listview {
    background-color:             transparent;
    margin:                        8px 4px 4px;
    lines:                         5;
    columns:                       1;
    fixed-height:                  false;
    spacing:                       4px;
}

element {
    padding:                       10px 16px;
    spacing:                       12px;
    border-radius:                 16px;
}

element normal.normal,
element alternate.normal {
    background-color:              @bg0;
    text-color:                    @fg0;
}

element selected.normal {
    background-color:              @bg0;
    text-color:                    @fg0;
    border:                         2px;
    border-color:                  @bg3;
}

element-icon {
    size:                          1.4em;
    vertical-align:                0.5;
}

element-text {
    text-color:                    inherit;
    vertical-align:                0.5;
}
