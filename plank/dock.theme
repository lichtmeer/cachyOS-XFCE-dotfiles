# MaterialPill - floating pill to match the polybar google-top bar
# palette: bg #1C1B1F, bg-alt #2A2930, primary #A4C3FF

[PlankTheme]
TopRoundness=5
BottomRoundness=28
LineWidth=2
OuterStrokeColor=42;;41;;48;;255
FillStartColor=28;;27;;31;;255
FillEndColor=28;;27;;31;;255
InnerStrokeColor=66;;64;;74;;90

[PlankDockTheme]
HorizPadding=8
TopPadding=1
BottomPadding=1
ItemPadding=3
IndicatorSize=5
IconShadowSize=1.25
UrgentBounceHeight=1.6666666666666667
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
BadgeColor=164;;195;;255;;255
